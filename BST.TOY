(load MATH.TOY)
(load LIST.TOY)

(define (bst-node bst-value left right)
    ; It's hi-how-are-you officer, not how-hi-are-you!
    (define how-high-are-you (+ 1 (max (bst-height left) (bst-height right))))
    [left bst-value how-high-are-you right])

(define (bst-value node)
    (car (cdr node)))

(define (bst-left node)
    (if (nil? node)
        node
        (car node)))

(define (bst-right node)
    (if (nil? node)
        node
        (car (cdr (cdr (cdr node))))))

(define (bst-height node)
    (if (nil? node)
        0
        (car (cdr (cdr node)))))

; ==== ABSTRACTION CURTAIN ====
; You are provided with tools to mess with a node. bst-node, bst-value, bst-left, bst-right, bst-height

(define (left-tug node)
    (bst-node (bst-value (bst-left node))
        (bst-left (bst-left node))
        (bst-node (bst-value node)
            (bst-right (bst-left node))
            (bst-right node))))

(define (right-tug node)
    (bst-node (bst-value (bst-right node))
        (bst-node (bst-value node)
            (bst-left node)
            (bst-left (bst-right node)))
        (bst-right (bst-right node))))

(define (right-left-tug node)
    (right-tug
        (bst-node (bst-value node)
            (bst-left node)
            (left-tug (bst-right node)))))

(define (left-right-tug node)
    (left-tug
        (bst-node (bst-value node)
            (right-tug (bst-left node))
            (bst-right node))))

(define (rebalance node)
    (define (balance-factor node)
        (- (bst-height (bst-right node)) (bst-height (bst-left node))))
    (cond
        ((< (balance-factor node) -1)
            (if (< (balance-factor (bst-left node)) 0)
                (left-tug node)
                (left-right-tug node)))
        ((< +1 (balance-factor node))
            (if (< (balance-factor (bst-right node)) 0)
                (right-left-tug node)
                (right-tug node)))
        (true node)))

(define (bst-lookup key target_key node)
    (cond
        ((nil? node) nil)
        ((< target_key (key (bst-value node))) (bst-lookup key target_key (bst-left node)))
        ((< (key (bst-value node)) target_key) (bst-lookup key target_key (bst-right node)))
        ((= target_key (key (bst-value node))) (bst-value node))))

(define (bst-with key x node)
    (cond
        ((nil? node) (bst-node x nil nil))
        ((< (key x) (key (bst-value node))) 
            (rebalance (bst-node (bst-value node)
                (bst-with key x (bst-left node))
                (bst-right node))))
        ((<= (key (bst-value node)) (key x))
            (rebalance (bst-node (bst-value node)
                (bst-left node)
                (bst-with key x (bst-right node)))))
        (true node)))

(define (bst-min node)
    (if (nil? node)
        nil
        (if (nil? (bst-left node))
            (bst-value node)
            (bst-min (bst-left node)))))

(define (bst-max node)
    (if (nil? node)
        nil
        (if (nil? (bst-right node))
            (bst-value node)
            (bst-max (bst-right node)))))

(define (bst-without-min node)
    (cond
        ((nil? node) node)
        ((nil? (bst-left node)) (bst-right node))
        (true (rebalance (bst-node (bst-value node)
            (bst-without-min (bst-left node))
            (bst-right node))))))

(define (bst-without-max node)
    (cond
        ((nil? node) node)
        ((nil? (bst-right node)) (bst-left node))
        (true (rebalance (bst-node (bst-value node)
            (bst-left node)
            (bst-without-max (bst-right node)))))))

(define (bst-without key some_key node)
    (cond
        ((nil? node) node)
        ((< some_key (key (bst-value node)))
            (rebalance (bst-node (bst-value node)
                (bst-without key some_key (bst-left node))
                (bst-right node))))
        ((< (key (bst-value node)) some_key)
            (rebalance (bst-node (bst-value node)
                (bst-left node)
                (bst-without key some_key (bst-right node)))))
        ((= some_key (key (bst-value node)))
            (cond 
                ((nil? (bst-left node)) (bst-right node))
                ((nil? (bst-right node)) (bst-left node))
                (true
                    (rebalance (bst-node (bst-min (bst-right node))
                        (bst-left node)
                        (bst-without key (bst-min (bst-right node)) (bst-right node)))))))))

(define (bst-size node)
    (if (nil? node) 
        0
        (incr (+ 
            (bst-size (bst-left node))
            (bst-size (bst-right node))))))

(define (inorder node)
    (if (nil? node)
        nil
        (append 
            (inorder (bst-left node))
            (cons (bst-value node) (inorder (bst-right node))))))

(define (make-bst elements)
    (define half (floor (/ (length elements) 2)))
    (if (nil? elements)
        nil
        (bst-node 
            (car (drop half elements)) 
            (make-bst (take half elements))
            (make-bst (cdr (drop half elements))))))

;; ==== ABSTRACTION CURTAIN ====
;; You are provided bst-with, bst-without, bst-lookup, bst-min, bst-max, inorder, make-bst


(define (bst-union key a b)
    (make-bst (union-sorted key (inorder a) (inorder b))))

(define (bst-intersection key a b)
    (make-bst (intersection-sorted key (inorder a) (inorder b))))

