(load LIST.TOY)
(load FUNCTIONS.TOY)

(define (make-binding key value)
    (cons key value))

(define (binding-key bind)
    (car bind))

(define (binding-value bind)
    (cdr bind))

;; ABSTRACTION CURTAIN

(define (with-binding bind bindings)
    (if (= bindings FAILED)
        FAILED
        (begin
            (define bound-to (lookup-bindings (binding-key bind) bindings))
            (cond
                ((= bound-to nil) (cons bind bindings))
                ((= bound-to (binding-value bind)) bindings)
                ((!= bound-to (binding-value bind)) FAILED)))))

(define (union-bindings a b)
    (cond
        ((= a FAILED) FAILED)
        ((nil? a) b)
        (true (with-binding (car a) (union-bindings (cdr a) b)))))

(define (lookup-bindings key bindings)
    (cond
        ((= bindings FAILED) nil)
        ((nil? bindings) nil)
        ((= (binding-key (car bindings)) key) (binding-value (car bindings)))
        (true (lookup-bindings key (cdr bindings)))))

(define empty-bindings nil)

;; ABSTRACTION CURTAIN

(define (deconstruct pattern expression)
    (define (unknown? x)
        (if (cons? x)
            (= (car x) (quote ?))
            false))
    (define (unknown-thing x)
        (car (cdr x)))
    (define (unknown-guard x)
        (if (nil? (cdr (cdr x)))
            nil
            (car (cdr (cdr x)))))
    (cond 
        ((and (nil? pattern) (nil? expression))
            empty-bindings)
        ((or (nil? pattern) (nil? expression))
            FAILED)
        ((atom? pattern)
            (if (= pattern expression)
                empty-bindings
                FAILED))
        ((unknown? pattern)
            (if (or (nil? (unknown-guard pattern)) ((eval (unknown-guard pattern)) expression))
                (with-binding (make-binding (unknown-thing pattern) expression) nil)
                FAILED))
        ((cons? pattern)
            (if (cons? expression)
                (union-bindings
                    (deconstruct (car pattern) (car expression))
                    (deconstruct (cdr pattern) (cdr expression)))
                FAILED))))

(define (evaluate bindings expression)
    (cond
        ((nil? expression)
            expression)
        ((number? expression)
            expression)
        ((symbol? expression)
            (lookup-bindings expression bindings))
        ((cons? expression)
            (apply (eval (car expression))
                (map (evaluate bindings) (cdr expression))))))

(define (construct bindings skeleton)
    (define (evaluate? x)
        (if (cons? x)
            (= (car x) (quote :))
            false))
    (define (evaluate-thing x)
        (car (cdr x)))
    (cond
        ((nil? skeleton)
            skeleton)
        ((atom? skeleton) 
            skeleton)
        ((evaluate? skeleton) 
            (evaluate bindings (evaluate-thing skeleton)))
        (true
            (cons 
                (construct bindings (car skeleton))
                (construct bindings (cdr skeleton))))))

(define (match-rule rule expression)
    (define (apply-rule rule expression)
        (define pattern (car rule))
        (define skeleton (car (cdr rule)))
        (define binds (deconstruct pattern expression))
        (if (= binds FAILED)
            expression
            (begin
                (define constructed (construct binds skeleton))
                (print CONSTRUCTION) (print constructed)
                (newline)
                constructed
            )))
    (if (cons? expression)
        (apply-rule rule
                (cons (match-rule rule (car expression))
                    (match-rule rule (cdr expression))))
        (apply-rule rule expression)))

(define (match rules expression)
    (if (nil? rules)
        expression
        (match (cdr rules) (match-rule (car rules) expression))))

(define (recursive-match rules expression) (fixed-point (match rules) expression))

;; ABSTACTION CURTAIN

(define simplify 
    (recursive-match
        '(   
            ((* (? c) (+ (? a) (? b)))
                (+ (* (: c) (: a)) (* (: c) (: b))))
            
            
            ((+ (? x number?) (? y number?))
                (: (+ x y)))
            ((+ (? x (dot not number?)) (? c number?))
                (+ (: c) (: x)))
            ((+ 0 (? x))
                (: x))

            ((- (? x))
                (* (: x) -1))
            ((- (? x) (? y))
                (* (: x) (- (: y))))
            

            ((* (? x number?) (? y number?))
                (: (* x y)))
            ((* (? x (dot not number?)) (? c number?))
                (* (: c) (: x)))
            ((* (? a number?) (* (? b number?) (? c)))
                (* (: (* a b)) (: c)))
            ((* 0 (? x))
                0)
            ((* 1 (? x))
                (: x))

            ((/ (? x))
                (^ (: x) -1))
            ((/ (? x) (? y))
                (* (: x) (/ (: y))))
            

        )
    )
)

(simplify 
    '(- (* (- 2) (+ x y)))
)