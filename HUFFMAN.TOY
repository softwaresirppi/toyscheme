(load LIST.TOY)
(load BST.TOY)

(define (huff-node symbols weight left right)
    [symbols weight left right])

(define (huff-symbols node) (car node))
(define (huff-weight node) (car (cdr node)))
(define (huff-left node) (car (cdr (cdr node))))
(define (huff-right node) (car (cdr (cdr (cdr node)))))

;; ABSTRACTION CURTAIN

(define (huff-leaf symbol weight)
    (huff-node [symbol] weight nil nil))

(define (merge-node a b)
    (huff-node 
        (append (huff-symbols a) (huff-symbols b))
        (+ (huff-weight a) (huff-weight b))
        a b))

(define (huff-tree nodes)
    (define (huff-tree-by-bst node)
        (if (= (bst-size node) 1)
            (bst-min node)
            (huff-tree-by-bst
                (bst-with huff-weight
                    (merge-node (bst-min node) (bst-min (bst-without-min node)))
                    (bst-without-min (bst-without-min node))))))
    (huff-tree-by-bst (make-bst (sort-by huff-weight nodes))))

(define (huff-encode tree message)
    (define (huff-encode-from tree symbol)
        (cond
            ((and (not (nil? (huff-left tree))) (contains? symbol (huff-symbols (huff-left tree))))
                (cons 0 (huff-encode-from (huff-left tree) symbol)))
            ((and (not (nil? (huff-right tree))) (contains? symbol (huff-symbols (huff-right tree))))
                (cons 1 (huff-encode-from (huff-right tree) symbol)))
            (true nil)))
    (flat-map (huff-encode-from tree) message))

(define (huff-decode full-tree code)
    (define (huff-decode-from tree code)
        (cond
            ((and (nil? (huff-left tree)) (nil? (huff-right tree)))
                (append (huff-symbols tree) (huff-decode-from full-tree code)))
            ((and (not (nil? code)) (= (car code) 0)) (huff-decode-from (huff-left tree) (cdr code)))
            ((and (not (nil? code)) (= (car code) 1)) (huff-decode-from (huff-right tree) (cdr code)))))
    (huff-decode-from full-tree code))

;; ABSTRACTION CURTAIN

